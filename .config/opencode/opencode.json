{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "share": "disabled",
  "compaction": {
    "auto": true,
    "buffer": 600000
  },
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "opencode", "effect": "deny" }
    ]
  },
  "agents": {
    "title": { "model": "deepseek/deepseek-v4-flash" },
    "build": { "model": "deepseek/deepseek-v4-pro#low" },
    "plan": { "model": "deepseek/deepseek-v4-pro#high" }
  },
  "providers": {
    "deepseek": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "DeepSeek",
      "settings": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-chat": { "name": "DeepSeek Chat" },
        "deepseek-v4-pro": {
          "variants": [
            { "id": "low", "body": { "reasoning_effort": "low" } },
            { "id": "high", "body": { "reasoning_effort": "high" } }
          ]
        }
      }
    },
    "z.ai": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "Z.ai",
      "settings": {
        "baseURL": "https://api.z.ai/api/paas/v4",
        "apiKey": "{env:ZAI_API_KEY}"
      },
      "models": {
        "glm-4.6": { "name": "GLM-4.6" },
        "glm-4.5": { "name": "GLM-4.5" }
      }
    }
  },
  "plugins": [
    "./plugins/caveman/plugin.js",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}
